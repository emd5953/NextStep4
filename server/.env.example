# Copy only if server/.env does not exist. Keep real keys out of Git.
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: never put this secret key in a VITE_ variable.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Leave the Google AI Studio project on Free tier with billing disabled.
JSEARCH_API_KEY=
# OpenWeb Ninja direct keys use this provider. Use rapidapi for a RapidAPI key.
JSEARCH_PROVIDER=openwebninja
# Select the subscribed product: linkedin or jsearch.
JOB_API_SOURCE=linkedin

# Set true only after configuring Google OAuth in Supabase.
SUPABASE_GOOGLE_ENABLED=false
